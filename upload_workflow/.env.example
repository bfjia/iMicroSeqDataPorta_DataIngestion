# Copy to upload_workflow/.env and fill in. Never commit .env.
# Portal logins (getToken.py), one per portal; PORTAL_ENV / --env picks which.
devPortalUser=your.name@example.com
devPortalPass=your-dev-password
prodPortalUser=your.name@example.com
prodPortalPass=your-prod-password
# Slack bot OAuth token (slack_post.py); only needed when SLACK_CHANNEL is set in pipeline.conf
duoliauthtoken=xoxb-your-bot-token
